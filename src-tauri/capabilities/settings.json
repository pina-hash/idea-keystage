{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "settings",
	"description": "The settings window: its own commands, event listening, file dialogs, copying a URL, and opening https links in the browser. No file system or shell access; every path goes to a command.",
	"windows": ["settings"],
	"permissions": [
		"core:event:allow-listen",
		"core:event:allow-unlisten",
		"dialog:allow-open",
		"dialog:allow-save",
		"clipboard-manager:allow-write-text",
		{
			"identifier": "opener:allow-open-url",
			"allow": [{ "url": "https://*" }]
		},
		"allow-get-settings",
		"allow-save-settings",
		"allow-reset-settings",
		"allow-get-status",
		"allow-list-monitors",
		"allow-set-paused",
		"allow-set-solidworks-mode",
		"allow-set-keyboard-visible",
		"allow-obs-test",
		"allow-obs-set-password",
		"allow-shortcuts-import-preview",
		"allow-shortcuts-import-apply",
		"allow-shortcuts-import-clear",
		"allow-profile-shortcuts",
		"allow-session-start",
		"allow-session-stop",
		"allow-session-marker",
		"allow-sessions-list",
		"allow-session-get",
		"allow-session-rename-marker",
		"allow-session-export",
		"allow-session-delete",
		"allow-settings-export",
		"allow-settings-import",
		"allow-server-urls",
		"allow-play-sound-preview",
		"allow-open-external-folder",
		"allow-overlay-hello",
		"allow-hotkeys-capture",
		"allow-hotkeys-status",
		"allow-platform-info"
	]
}
