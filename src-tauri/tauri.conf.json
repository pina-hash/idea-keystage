{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "IDEA Keystage",
	"mainBinaryName": "idea-keystage",
	"version": "0.1.0",
	"identifier": "com.ideabosco.keystage",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://127.0.0.1:5173",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' data:"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"category": "Productivity",
		"shortDescription": "Keystroke, keyboard and mouse visualizer for tutorial recording",
		"copyright": "IDEA Engineering Pathway"
	}
}
