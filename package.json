{
	"name": "idea-keystage",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "IDEA Keystage: keystroke, keyboard and mouse visualizer for SolidWorks tutorial recording on Windows, with OBS Browser Sources.",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview --port 4173 --strictPort",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "vitest run",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"tauri": "tauri"
	},
	"dependencies": {
		"@fontsource/orbitron": "5.3.0",
		"@fontsource/rajdhani": "5.3.0",
		"@fontsource/share-tech-mono": "5.3.0",
		"@tauri-apps/api": "2.12.1",
		"@tauri-apps/plugin-autostart": "2.7.0",
		"@tauri-apps/plugin-clipboard-manager": "2.4.1",
		"@tauri-apps/plugin-dialog": "2.8.1",
		"@tauri-apps/plugin-global-shortcut": "2.4.0",
		"@tauri-apps/plugin-opener": "2.7.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tauri-apps/cli": "2.12.1",
		"@types/node": "26.6.3",
		"jsdom": "29.1.1",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"vite": "8.3.1",
		"vitest": "5.0.3"
	}
}
